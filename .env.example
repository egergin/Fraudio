# ==========================================================================
# Fraudio — Ortam Yapılandırması Örneği
#
# Bu dosyayı .env olarak kopyalayın ve değerleri kendi ortamınıza göre
# düzenleyin:
#
#   cp .env.example .env
#
# .env dosyası .gitignore tarafından yok sayılır. Buradaki değerler yalnızca
# yerel geliştirme içindir; gerçek gizli anahtarları asla depoya işlemeyin.
# ==========================================================================

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=fraudio
POSTGRES_USER=fraudio
POSTGRES_PASSWORD=replace-postgres-password
POSTGRES_CONNECTION=Host=postgres;Database=fraudio;Username=fraudio;Password=replace-postgres-password

# --- Redis ----------------------------------------------------------------
REDIS_CONNECTION=redis:6379

# --- RabbitMQ -------------------------------------------------------------
RABBITMQ_USER=fraudio
RABBITMQ_PASSWORD=replace-rabbitmq-password

# --- JWT ------------------------------------------------------------------
# JWT_SECRET en az 32 karakter olmalıdır (HMAC-SHA256 gereksinimi).
JWT_ISSUER=Fraudio
JWT_AUDIENCE=FraudioDashboard
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# --- Başlangıç kullanıcıları ----------------------------------------------
# Backend açılışında oluşturulan varsayılan panel hesaplarının şifreleri.
SEED_ADMIN_PASSWORD=replace-admin-password
SEED_ANALYST_PASSWORD=replace-analyst-password

# --- MCP sunucusu ---------------------------------------------------------
# MCP konteyneri backend API'sine bu kimlik bilgileriyle bağlanır.
# Yönetici hesabıyla aynı olmalıdır.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-admin-password

# ==========================================================================
# Demo İşlem Üreteci
#
# Panelde sürekli değişen demo etkinliği oluşturmak için periyodik olarak
# rastgele bir işlem üretir. Üretilen işlem, normal bir POST /api/transactions
# çağrısıyla tamamen aynı yoldan geçer: RabbitMQ → TransactionWorker →
# dolandırıcılık kuralları → Redis + PostgreSQL → WebSocket bildirimi.
#
# Yalnızca demo/geliştirme ortamları içindir ve varsayılan olarak KAPALIDIR.
# ==========================================================================

# Üreteci aç/kapat. Kapalıyken barındırılan servis hiç kaydedilmez.
DEMO_TRANSACTION_GENERATOR_ENABLED=false

# Üretim aralığı (dakika). Ondalık değer kabul edilir; hızlı doğrulama için
# örneğin 0.5 kullanılabilir.
DEMO_TRANSACTION_INTERVAL_MINUTES=30

# Üretilen tutar aralığı. İki ondalık basamağa yuvarlanır.
DEMO_TRANSACTION_MIN_AMOUNT=10
DEMO_TRANSACTION_MAX_AMOUNT=5000

# Kullanılacak konumlar (virgülle ayrılmış). Boş bırakılırsa katalogun tamamı
# kullanılır. Geçerli değerler DemoLocationCatalogue içinde tanımlıdır:
#   Istanbul, Ankara, Izmir, Bursa, Antalya, London, Berlin, Amsterdam,
#   Paris, Madrid, Dubai, Singapore, Tokyo, New York, Sao Paulo
# DEMO_TRANSACTION_LOCATIONS=Istanbul,Ankara,London,Tokyo,New York

# Uygulama açılışında hemen bir işlem üretilsin mi. Varsayılan davranış,
# önce bir aralık beklemektir.
DEMO_TRANSACTION_RUN_ON_STARTUP=false
