# PostgreSQL
POSTGRES_USER=fraudio
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fraudio
# Backend EF Core
CONNECTIONSTRINGS__POSTGRES=Host=postgres;Port=5432;Database=fraudio;Username=fraudio;Password=changeme

# Redis
REDIS__CONNECTION=localhost:6379

# RabbitMQ
RABBITMQ__HOST=localhost
RABBITMQ__PORT=5672
RABBITMQ__USERNAME=fraudio
RABBITMQ__PASSWORD=changeme
RABBITMQ_MANAGEMENT_PORT=15672

# JWT
JWT__SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT__ISSUER=Fraudio
JWT__AUDIENCE=Fraudio
JWT__EXPIRYMINUTES=60

# Backend / API
ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT=8080

# Transaction simulator
SIMULATOR__ENABLED=true
SIMULATOR__MINDELAYMINUTES=30
SIMULATOR__MAXDELAYMINUTES=120
SIMULATOR__INITIALDELAYMINUTES=2
SIMULATOR__SUSPICIOUSPROBABILITY=0.15

# Frontend (Vite dev port; talks to backend via VITE_API_URL)
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws

# MCP
MCP_PORT=8090
BACKEND_INTERNAL_URL=http://backend:8080
MCP__BACKENDUSERNAME=analyst
MCP__BACKENDPASSWORD=Analyst123!

# Geolocation
GEOLOCATION__BASEURL=https://geocoding-api.open-meteo.com

# Seed users
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_EMAIL=admin@fraudio.com
SEED_ANALYST_USERNAME=analyst
SEED_ANALYST_PASSWORD=Analyst123!
SEED_ANALYST_EMAIL=analyst@fraudio.com
